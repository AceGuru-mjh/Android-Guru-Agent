<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层：外发光柔和阴影 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3300F0FF" />
        </shape>
    </item>

    <!-- 中层：高光黑曜石球体主体 -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <!-- 上亮下暗的黑曜石渐变 -->
            <gradient
                android:angle="270"
                android:startColor="#252A34"
                android:centerColor="#0F1218"
                android:endColor="#05070A"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#4000F0FF" /> <!-- 微光极细边框 -->
        </shape>
    </item>

    <!-- 顶层：高光反射弧（镜面感来源） -->
    <item android:top="4dp" android:left="8dp" android:right="8dp" android:height="16dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
