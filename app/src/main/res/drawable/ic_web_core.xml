<?xml version="1.0" encoding="utf-8"?>
<!--
  Web 核心图标 — 精修线框地球：外圈 + 中央经线 + 侧经线（梭形） +
  两条朝赤道弯曲的椭圆纬线。纯描边白色，由 android:tint 着色为霓虹青。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 外圈 -->
    <path
        android:pathData="M12,2.6 A9.4,9.4 0 1,1 12,21.4 A9.4,9.4 0 1,1 12,2.6 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7" />
    <!-- 中央经线 -->
    <path
        android:pathData="M12,2.6 V21.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2" />
    <!-- 侧经线（梭形） -->
    <path
        android:pathData="M12,2.6 C7.6,7.2 7.6,16.8 12,21.4 C16.4,16.8 16.4,7.2 12,2.6 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2" />
    <!-- 纬线（朝赤道弯曲） -->
    <path
        android:pathData="M3.1,9 A11.5,4.1 0 0 0 20.9,9"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M3.1,15 A11.5,4.1 0 0 1 20.9,15"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2" />
</vector>
