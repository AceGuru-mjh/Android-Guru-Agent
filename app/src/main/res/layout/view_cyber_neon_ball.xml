<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ballContainer"
    android:layout_width="68dp"
    android:layout_height="68dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Layer 0: 人工接入时的外扩散脉冲光环 (默认隐藏) -->
    <View
        android:id="@+id/pulseRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pulse_warning_ring"
        android:visibility="invisible" />

    <!-- Layer 1: 高光黑曜石底座 -->
    <View
        android:id="@+id/obsidianBase"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_obsidian_glossy" />

    <!-- Layer 2a: 动态霓虹等离子光环 (代码绘制，默认显示；放入 res/raw/anim_neon_*.json 时自动让位给 Lottie) -->
    <com.apex.agent.browser.NeonRingView
        android:id="@+id/neonRing"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center" />

    <!-- Layer 2b: 可选 Lottie 流光环 (默认隐藏；当 res/raw/anim_neon_<state>.json 存在时显示并改色) -->
    <com.airbnb.android.lottie.LottieAnimationView
        android:id="@+id/lottieRing"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <!-- Layer 3: 中心 web 图标 -->
    <ImageView
        android:id="@+id/imgCoreIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_web_core"
        app:tint="#00F0FF" />

    <!-- Layer 4: NEED_HUMAN 状态下的闪耀 Badge -->
    <TextView
        android:id="@+id/badgeAlert"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_cyber_badge"
        android:gravity="center"
        android:text="!"
        android:textColor="#000000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
