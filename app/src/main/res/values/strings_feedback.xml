<?xml version="1.0" encoding="utf-8"?>
<!-- Unified feedback layer + network state strings (English default) — FeedbackController/FeedbackHost
     (Snackbar convergence layer) + OfflineBanner (offline banner) + NetworkMonitor (network type names).
     Chinese lives in values-zh/strings_feedback.xml; escaping conventions (apostrophe \') aligned with
     strings_core.xml. Note: net_status_* / feedback_hint_* / feedback_action_retry /
     feedback_dismiss are reserved for migration wiring (consumed when the host replaces the 17 bare Toasts
     and network event toasts); landed ahead of consumers, do not delete. -->
<resources>
    <!-- ═══ Network type names (NetworkMonitor.currentSummaryRes) ═══ -->
    <string name="net_kind_wifi">Wi-Fi</string>
    <string name="net_kind_cellular">Mobile data</string>
    <string name="net_kind_ethernet">Ethernet</string>
    <string name="net_kind_vpn">VPN</string>
    <string name="net_kind_other">Other network</string>
    <string name="net_kind_offline">Offline</string>

    <!-- ═══ Offline banner (OfflineBanner) ═══ -->
    <string name="net_banner_offline">No network connection. Some features won\'t be available.</string>
    <string name="net_banner_icon_desc">Network offline</string>

    <!-- ═══ Network event toasts (host wiring: NetworkMonitor.isOnline edge → FeedbackController) ═══ -->
    <string name="net_status_lost">Network connection lost</string>
    <string name="net_status_reconnected">Back online (%1$s)</string>

    <!-- ═══ Feedback severity names (FeedbackSeverity.labelRes) ═══ -->
    <string name="feedback_severity_info">Info</string>
    <string name="feedback_severity_success">Success</string>
    <string name="feedback_severity_warning">Warning</string>
    <string name="feedback_severity_error">Error</string>

    <!-- ═══ Feedback layer generic copy (Toast migration / offline request failure toast reserved) ═══ -->
    <string name="feedback_hint_offline">You\'re offline. Check your connection and try again.</string>
    <string name="feedback_hint_request_failed">Request failed. Please try again.</string>
    <string name="feedback_action_retry">Retry</string>
    <string name="feedback_dismiss">Dismiss</string>
</resources>
