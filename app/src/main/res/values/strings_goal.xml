    <string name="goal_rounds_progress">Round %1$d/%2$d</string>
    <string name="goal_last_check_none">No verification yet</string>
    <string name="goal_stop">Stop goal</string>
    <string name="goal_resume">Restart goal</string>
    <string name="goal_cd_goal_status">Goal status card</string>

    <!-- ═══ 会话内系统提示（CodeGoalController）═══ -->
    <string name="goal_started_notice">🎯 Goal set: %1$s</string>
    <string name="goal_stopped_notice">⛔ Goal stopped</string>
    <string name="goal_restart_notice">🔁 Goal restarted — resuming work</string>
