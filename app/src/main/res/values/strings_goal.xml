<?xml version="1.0" encoding="utf-8"?>
<!-- S1 Goal 目标模式字符串（英文默认；中文在 values-zh/strings_goal.xml）。
     资源名全局唯一：全部 goal_ 前缀（settings_v3_goal_* 等既有键带模块前缀，无冲突）。 -->
<resources>

    <!-- ═══ 设定弹层（GoalSetupSheet）═══ -->
    <string name="goal_setup_title">Set Up Goal</string>
    <string name="goal_statement_label">Goal statement</string>
    <string name="goal_statement_placeholder">Fix the login screen crash</string>
    <string name="goal_setup_empty_statement">Goal statement cannot be empty</string>
    <string name="goal_criteria_label">Acceptance criteria (verifiable)</string>
    <string name="goal_criteria_placeholder">All tests pass (./gradlew test, zero failures)\nApp launches to the home screen</string>
    <string name="goal_criteria_hint">Criteria must be objectively verifiable — the verifier judges by evidence (command output / file contents / test results), not by “should be fine”.</string>
    <string name="goal_setup_empty_criteria">Acceptance criteria cannot be empty</string>
    <string name="goal_max_rounds">Max verification rounds</string>
    <string name="goal_start">Start goal</string>
    <string name="goal_how_it_works">How it works</string>
    <string name="goal_how_it_works_body">After each round the agent finishes, a fast model checks the work against the criteria. If not met, the agent keeps working with the gap analysis injected, until the goal is achieved or the rounds run out.</string>

