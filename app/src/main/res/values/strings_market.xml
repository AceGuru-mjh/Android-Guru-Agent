    <!-- ═══ Browse · MCP ═══ -->
    <string name="market_mcp_header">MCP is not necessarily a server: the STDIO form is just a local command (e.g. npx -y @modelcontextprotocol/server-memory) that the App launches as a child process communicating over stdin/stdout. Added tool sources appear in the / menu once enabled (/mcp:&lt;name&gt;).</string>
    <string name="market_mcp_add_title">Add tool source</string>
    <string name="market_mcp_add_desc">Remote HTTP / SSE or local command STDIO, with apiKey support; connects automatically after adding.</string>
    <string name="market_mcp_import_card_title">Import config</string>
    <string name="market_mcp_import_desc">Paste the community-standard MCP config JSON ({\"mcpServers\": \u2026}), supporting both command/args/env and url forms.</string>
    <string name="market_mcp_import_file_title">Import from local file</string>
    <string name="market_mcp_import_file_desc">Pick an MCP config file on the device (.json, e.g. mcp.json exported from desktop Claude/Cursor); entries that fail to parse report their reasons one by one.</string>
    <string name="market_mcp_choose_file">Choose file</string>
    <string name="market_mcp_manage_hint">Added MCP tool sources are managed (connect / disconnect / toggle / delete) under \u201CInstalled \u00B7 MCP\u201D.</string>

    <!-- ═══ Browse · Connectors ═══ -->
    <string name="market_connectors_header">A connector = access configuration for an external service (API/SSH/database/cloud drive). Enabled connectors appear in the / menu (/connector:&lt;id&gt;).</string>
    <string name="market_connectors_add_title">Add connector</string>
    <string name="market_connectors_add_desc">Register id / name / type / endpoint; after saving, invoke it in conversations via /connector:&lt;id&gt;.</string>
    <string name="market_connectors_manage_hint">Enable/disable and delete existing connectors under \u201CInstalled \u00B7 Connectors\u201D.</string>

