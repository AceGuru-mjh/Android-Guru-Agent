<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background — obsidian deep-space with cyan core glow.
  与悬浮球 UI 同源配色：#0F1218 黑曜石 / #00F0FF 霓虹青 / #FFB800 琥珀。
  对角渐变 + 居中辉光在任何 mask（圆/方/圆角矩形）下均成立。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底层：黑曜石对角渐变 -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF1E2836" />
                <item android:offset="0.55" android:color="#FF0B111C" />
                <item android:offset="1" android:color="#FF05070A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中层：核心青色辉光（径向） -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="47"
                android:gradientRadius="36">
                <item android:offset="0" android:color="#4000F0FF" />
                <item android:offset="0.55" android:color="#1A00F0FF" />
                <item android:offset="1" android:color="#0000F0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 底部：琥珀地平微光，呼应 NEED_HUMAN 状态色 -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="102"
                android:gradientRadius="30">
                <item android:offset="0" android:color="#2EFFB800" />
                <item android:offset="1" android:color="#00FFB800" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 顶层：左上玻璃斜切高光 -->
    <path
        android:fillColor="#0DFFFFFF"
        android:pathData="M0,0 H108 L0,64 Z" />
</vector>
