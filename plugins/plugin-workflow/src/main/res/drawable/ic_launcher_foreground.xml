<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — 霓虹灯管 "A" monogram for Apex Agent.
  三层结构：宽幅青晕 → 窄幅青晕 → 白→冰蓝渐变灯管，中心火花点。
  内容收在 66dp 安全区内（x 21..87, y 21..87），含光晕外沿。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Layer 0: 宽幅柔和青晕 -->
    <path
        android:pathData="M36,79 L54,29.5 L72,79"
        android:strokeColor="#2200F0FF"
        android:strokeWidth="21"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Layer 1: 窄幅青晕 -->
    <path
        android:pathData="M36,79 L54,29.5 L72,79 M44,64 H64"
        android:strokeColor="#4400F0FF"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Layer 2: 灯管主体（白→冰蓝渐变，圆角端点） -->
    <path
        android:pathData="M36,79 L54,29.5 L72,79"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="29.5"
                android:endX="54" android:endY="79">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFBFF2FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 横梁灯管 -->
    <path
        android:pathData="M44,64 H64"
        android:strokeWidth="9"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="44" android:startY="64"
                android:endX="64" android:endY="64">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFBFF2FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Layer 3: 中心火花点（青 + 白芯） -->
    <path
        android:fillColor="#FF00F0FF"
        android:pathData="M54,51 m-2.6,0 a2.6,2.6 0 1,1 5.2,0 a2.6,2.6 0 1,1 -5.2,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,51 m-1.2,0 a1.2,1.2 0 1,1 2.4,0 a1.2,1.2 0 1,1 -2.4,0" />
</vector>
